DB_HOST=localhost
DB_PORT=5555         
DB_NAME=hms_db

# App role — LEAST PRIVILEGE: DML only, no DDL, no superuser.
# Provisioned by `npm run db:setup-roles` (src/db/setup-roles.js).
DB_USER=hms_api
DB_PASSWORD=Api@Hms2026

# Migrator role — DDL rights, used ONLY by `npm run migrate`.
DB_MIGRATOR_HOST=localhost
DB_MIGRATOR_PORT=5555
DB_MIGRATOR_NAME=hms_db
DB_MIGRATOR_USER=hms_migrator
DB_MIGRATOR_PASSWORD=Migrate@Hms2026

# Read-only role (optional — analytics/reporting that needs no writes).
DB_READONLY_USER=hms_readonly
DB_READONLY_PASSWORD=Read@Hms2026

# Bootstrap/setup superuser — used ONLY by `npm run db:setup-roles`.
