# ── Application Branding ───────────────────────────────────────────────────────
HMS_NAME=City General Hospital
HMS_ADDRESS=123 Medical Lane, Healthcare City, HC 12345
HMS_CONTACT=contact@hospital.local
HOSPITAL_NAME=City General Hospital

# ── Super Admin (used by seed script) ─────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@hospital.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
PG_CRYPTO_KEY=your-32-char-encryption-key-here
LEAVE_YEAR=2026

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
CSRF_SECRET=change-me-to-a-random-64-char-string

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Default: POSTGRES_USER=postgres, POSTGRES_PASSWORD=root, exposed on port 5555
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hms
DB_USER=hms_user
DB_PASSWORD=changeme
DB_POOL_MAX=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_ENCRYPTION_KEY=your-32-char-db-encryption-key-here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0
REDIS_QUEUE_DB=1

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=hms
JWT_AUDIENCE=hms-client

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hospital.local
VAPID_CONTACT_EMAIL=admin@hospital.local

# ── File Storage ──────────────────────────────────────────────────────────────
FILE_STORAGE_PATH=./uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=20971520

# ── AI / Chatbot ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Use Mailhog locally: SMTP port 1025, web UI http://localhost:8025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=admin@hospital.local

# ── Razorpay (test mode) ──────────────────────────────────────────────────────
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=razorpay_test_XXXXXXXXXXXXXX

# ── Telemedicine ──────────────────────────────────────────────────────────────
TELE_ROOM_SECRET=change-me-in-production
APP_URL=http://localhost:5173

# ── Inventory ──────────────────────────────────────────────────────────────────
INVENTORY_QR_SECRET=change-me-qr-secret

# ── Debug ─────────────────────────────────────────────────────────────────────
SLOW_QUERY_THRESHOLD_MS=500
EMAIL_WORKER_CONCURRENCY=3
NOTIFICATION_WORKER_CONCURRENCY=5
REPORT_WORKER_CONCURRENCY=2
